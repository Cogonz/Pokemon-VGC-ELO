generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model standings {
  id            Int            @id @default(autoincrement())
  tournament_id String
  player        String
  name          String
  placement     Int?
  wins          Int
  losses        Int
  ties          Int
  tournaments   tournaments    @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team_pokemon  team_pokemon[]

  @@unique([tournament_id, player])
}

model team_pokemon {
  id          Int       @id @default(autoincrement())
  standing_id Int
  species_id  String
  name        String
  item        String?
  ability     String?
  nature      String?
  tera        String?
  moves       String[]  @default([])
  standings   standings @relation(fields: [standing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([species_id], map: "team_pokemon_species_idx")
}

model tournaments {
  id        String      @id
  name      String
  format    String?
  date      DateTime?   @db.Timestamptz(6)
  players   Int?
  matches   matches[]
  standings standings[]
}

model matches {
  id            Int         @id @default(autoincrement())
  tournament_id String
  phase         Int
  round         Int
  player1       String
  player2       String
  winner        String?
  tournaments   tournaments @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tournament_id, phase, round, player1, player2])
  @@index([player1])
  @@index([player2])
}

model move_reference {
  move_slug    String @id
  display_name String
  type         String
  damage_class String
  power        Int?
}

model pokemon_species {
  species_id String  @id
  type1      String
  type2      String?
}

// Precomputed by ingestion (lib/ratings-store.ts) so page/API requests only read.
model pokemon_elo {
  format     String
  species_id String
  name       String
  rating     Int
  wins       Int
  losses     Int
  ties       Int
  matches    Int

  @@id([format, species_id])
}

model player_elo {
  format String
  player String
  name   String
  rating Int
  wins   Int
  losses Int
  ties   Int

  @@id([format, player])
}
