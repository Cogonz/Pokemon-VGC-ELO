generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model standings {
  id            Int            @id @default(autoincrement())
  tournament_id String
  player        String
  name          String
  placement     Int?
  wins          Int
  losses        Int
  ties          Int
  tournaments   tournaments    @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team_pokemon  team_pokemon[]

  @@unique([tournament_id, player])
}

model team_pokemon {
  id          Int       @id @default(autoincrement())
  standing_id Int
  species_id  String
  name        String
  item        String?
  ability     String?
  nature      String?
  tera        String?
  moves       String[]  @default([])
  standings   standings @relation(fields: [standing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([species_id], map: "team_pokemon_species_idx")
}

model tournaments {
  id        String      @id
  name      String
  format    String?
  date      DateTime?   @db.Timestamptz(6)
  players   Int?
  matches   matches[]
  standings standings[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  saved_teams   saved_teams[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model matches {
  id            Int         @id @default(autoincrement())
  tournament_id String
  phase         Int
  round         Int
  player1       String
  player2       String
  winner        String?
  tournaments   tournaments @relation(fields: [tournament_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tournament_id, phase, round, player1, player2])
  @@index([player1])
  @@index([player2])
}

model saved_teams {
  id         Int      @id @default(autoincrement())
  user_id    String
  name       String
  pokemon    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
  User       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "saved_teams_user_idx")
}

model move_reference {
  move_slug    String @id
  display_name String
  type         String
  damage_class String
  power        Int?
}

model pokemon_species {
  species_id String  @id
  type1      String
  type2      String?
}
